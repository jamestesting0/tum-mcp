# Draft only: this file is not an active GitHub workflow.
# Enable only after the maintainer verifies namespace ownership, the exact release
# artifact, all release gates, and a stage-only npm trusted-publisher configuration.
name: Stage reviewed TUM MCP release
on:
  workflow_dispatch:
    inputs:
      authorize_registry_staging:
        description: Explicitly authorize staging this reviewed revision
        type: boolean
        required: true
        default: false
permissions:
  contents: read
jobs:
  stage:
    if: inputs.authorize_registry_staging
    runs-on: ubuntu-latest
    environment: npm-staging
    permissions:
      contents: read
      id-token: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
      - uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38
        with:
          node-version: '22.22.2'
          registry-url: https://registry.npmjs.org
      - uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9
        with:
          version: '0.12.5'
      - run: npm install --global npm@11.21.1
      - run: uv sync --locked
      - run: uv run ruff check src tests plugin/scripts scripts
      - run: uv run pytest -q -m 'not live'
      - run: node npm/build.mjs
      - run: npm test
      - run: npm pack --ignore-scripts --pack-destination dist --json > dist/release-pack.json
      # Add the reviewed host/model activation report and platform acceptance gate
      # before enabling this template. Their absence must block registry staging.
      - name: Required release evidence
        run: |
          test -f release-evidence/activation-and-platforms-approved.json
          node -e "const r=require('./release-evidence/activation-and-platforms-approved.json'); if(r.approved!==true || r.sourceRevision!==process.env.GITHUB_SHA) process.exit(1)"
      - run: npm stage publish dist/jamestesting888-tum-mcp-0.4.0.tgz --access public
      # A maintainer reviews and approves the staged payload with 2FA separately.
