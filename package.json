{
  "name": "@jamestesting888/tum-mcp",
  "version": "0.9.1",
  "description": "Read-only TUM campus tools and source-backed study, exercise and lecture workflows",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tum-mcp": "npm/tum-mcp.mjs"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "files": [
    "npm/tum-mcp.mjs",
    "npm/ui.mjs",
    "npm/runtime.mjs",
    "npm/download.mjs",
    "npm/lock.mjs",
    "npm/npm-command.mjs",
    "npm/package-manager.mjs",
    "npm/uv-artifacts.json",
    "npm/backend/*.whl",
    "npm/backend/requirements.txt",
    "npm/backend/manifest.json",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "README.md",
    "docs/setup.md",
    "docs/development.md",
    "docs/tum-mcp.md",
    "docs/study.md",
    "docs/lecture-notes.md"
  ],
  "scripts": {
    "prepack": "node npm/build.mjs",
    "test": "node --test npm/test/*.test.mjs",
    "test:consumer": "node npm/smoke-consumer.mjs",
    "test:upgrade": "node npm/upgrade-consumer.mjs",
    "test:package-lifecycle": "node npm/package-consumer.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamestesting0/tum-mcp.git"
  },
  "homepage": "https://github.com/jamestesting0/tum-mcp#readme",
  "bugs": {
    "url": "https://github.com/jamestesting0/tum-mcp/issues"
  },
  "keywords": [
    "mcp",
    "tum",
    "moodle",
    "artemis",
    "zulip",
    "codex",
    "tumonline",
    "studocu",
    "lecture-notes"
  ]
}
