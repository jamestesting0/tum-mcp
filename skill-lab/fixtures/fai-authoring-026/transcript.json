[{"interval":{"start_s":0.0,"end_s":1.9039455782312926},"text":"Today we will trace a search graph.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":7.0,"end_s":9.237369614512472},"text":"An arrow is a legal move in one direction.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":14.0,"end_s":15.939319727891156},"text":"The number by an arrow is its cost.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":21.0,"end_s":23.06702947845805},"text":"The start is S, and the goal is G.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":28.0,"end_s":30.16090702947846},"text":"From S, we can go to A for three.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":35.0,"end_s":37.149297052154196},"text":"From S, we can go to B for one.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":42.0,"end_s":44.05963718820862},"text":"B also has an edge to the goal for eight.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":49.0,"end_s":50.49442176870748},"text":"A reaches the goal for three.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":56.0,"end_s":58.28952380952381},"text":"We store the best known cost to each state.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":63.0,"end_s":64.16072562358276},"text":"Call that cost g.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":70.0,"end_s":72.11160997732426},"text":"The estimate of remaining cost is h.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":77.0,"end_s":79.14448979591836},"text":"Add g and h to get priority f.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":84.0,"end_s":85.57755102040817},"text":"The estimate at S is zero.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":91.0,"end_s":92.48467120181405},"text":"The estimate at A is zero.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":98.0,"end_s":99.3801814058957},"text":"The estimate at B is four.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":105.0,"end_s":106.69365079365079},"text":"The estimate at the goal is zero.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":112.0,"end_s":113.51895691609977},"text":"Put the start on the frontier.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":119.0,"end_s":121.36816326530612},"text":"Pop S and examine its outgoing arrows.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":126.0,"end_s":127.63369614512472},"text":"A now has priority three.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":133.0,"end_s":134.69972789115647},"text":"B now has priority five.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":140.0,"end_s":141.30004535147393},"text":"Pop A at cost three.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":147.0,"end_s":149.04031746031745},"text":"It offers a path to the goal for six.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":154.0,"end_s":157.0344671201814},"text":"B has priority five, so we pop B next.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":161.0,"end_s":163.40371882086168},"text":"The path from S through B costs one so far.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":168.0,"end_s":170.0414058956916},"text":"Check B's arrow to A before committing.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":175.0,"end_s":177.18312925170068},"text":"The candidate cost of A through B is two.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":182.0,"end_s":183.81160997732425},"text":"The previous cost of A was three.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":189.0,"end_s":190.42639455782313},"text":"This is a strict improvement.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":196.0,"end_s":198.39591836734695},"text":"Move A back onto the frontier at cost two.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":203.0,"end_s":204.64362811791383},"text":"Now A has priority two.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":210.0,"end_s":210.905306122449},"text":"Pop A again.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":217.0,"end_s":218.9471655328798},"text":"A offers a new path to G for five.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":224.0,"end_s":225.8881179138322},"text":"Replace the old cost of six.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":231.0,"end_s":232.64362811791383},"text":"Now pop G at cost five.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":238.0,"end_s":240.27700680272108},"text":"Follow the parent pointers back from G.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":245.0,"end_s":247.45968253968255},"text":"They give S, B, A, then G.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":252.0,"end_s":254.8712925170068},"text":"Guest speaker here. The tutorial room changed.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":259.0,"end_s":260.52916099773245},"text":"Ask the tutor for the new room.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":266.0,"end_s":267.31619047619046},"text":"Back to the search graph.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":273.0,"end_s":275.3766893424036},"text":"An earlier expansion can be superseded.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":280.0,"end_s":282.5290249433107},"text":"Closing a node is not a proof about all paths.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":287.0,"end_s":289.63351473922904},"text":"Check an improved cost even for closed states.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":294.0,"end_s":296.71532879818596},"text":"The estimate at B equals the true remaining cost.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":301.0,"end_s":303.1507029478458},"text":"So at B it does not overestimate.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":308.0,"end_s":310.6281179138322},"text":"But compare the estimates across the arrow to A.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":315.0,"end_s":317.0331972789116},"text":"Four is larger than one plus zero.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":322.0,"end_s":323.86757369614514},"text":"This edge violates consistency.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":329.0,"end_s":331.05541950113377},"text":"The slides use the same search trace.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":336.0,"end_s":337.9526530612245},"text":"One slide caption has a typo.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":343.0,"end_s":344.83283446712016},"text":"There is a correction on the next deck.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":350.0,"end_s":352.65714285714284},"text":"The edge from B to A costs one, not two.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":357.0,"end_s":360.2806349206349},"text":"Now consider resolution. Each clause is a disjunction.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":364.0,"end_s":367.3509750566893},"text":"Resolve P or Q with not P or R to obtain Q or R.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":371.0,"end_s":373.584716553288},"text":"Resolve Q or R with not Q to obtain R.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":378.0,"end_s":380.5546485260771},"text":"The first slide already showed the first resolvent.","origin":"subtitle","uncertainty":"","words":[]},{"interval":{"start_s":385.0,"end_s":387.93342403628117},"text":"I will repeat that first slide: it gives Q or R.","origin":"subtitle","uncertainty":"","words":[]}]