          "paragraphs": [
            "Explain why depth-first search can use a stack instead of recursion."
          ]
        },
        {
          "kind": "code",
          "title": "Recursive search",
          "sources": [
            "components"
          ],
          "language": "python",
          "code": "def dfs(node, seen):\n    seen.add(node)\n    for nxt in node.neighbours:\n        if nxt not in seen:\n            dfs(nxt, seen)",
          "explanation": "Rewrite this without recursion."
        }
      ],
      "marking": [
        {
          "text": "Stack replaces the call stack",
          "points": 8
        }
      ],
      "minutes": 30,
      "difficulty": 2,
      "solution": {
        "answers": [
          {
            "blocks": [
              {
                "kind": "text",
                "title": "Solution",
                "sources": [
                  "components"
                ],
                "paragraphs": [
                  "Recursion keeps pending nodes on the call stack; an explicit stack stores the same frontier."
                ]
              }
            ]
          }
        ]
      }
