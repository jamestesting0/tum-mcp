        {
          "key": "mark-on-enqueue",
          "title": "Tracing duplicate enqueues through a shared neighbour",
          "interval": {
            "start_s": 1390,
            "end_s": 1665
          },
          "teaches": "Marking at enqueue time keeps every vertex in the queue once, so BFS runs in \\(O(V+E)\\).",
          "points": [
            "Marking at dequeue time lets a vertex enter the queue once per incoming edge."
          ],
          "evidence": [
