              ],
              "check": {
                "kind": "self_check",
                "format": "math",
                "rubric": [
                  "States the positive-integer assumption.",
                  "Explains a pairing or induction argument."
                ],
                "model_answer": "Pair the first and last terms; every pair sums to n + 1. Account for the middle term when n is odd."
              },
              "explanation": "Compare the argument, not just the final formula.",
              "hints": []
            },
            {
              "key": "code",
              "purpose": "Show a saved code response and prepared rubric.",
