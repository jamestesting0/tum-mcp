          "steps": [
            {
              "key": "number",
              "purpose": "Demonstrate finite decimal input.",
              "prompt": "Enter 2 + 2.",
              "check": {
                "kind": "numeric",
                "answer": 4,
                "tolerance": 0,
                "feedback": "Add both supplied values."
              },
              "hints": [
                "Count two pairs."
              ],
              "explanation": "2 + 2 = 4."
            },
            {
              "key": "choice",
              "purpose": "Demonstrate four-option feedback.",
              "prompt": "Select 2 + 2.",
              "check": {
                "kind": "choice",
                "options": [
                  {
                    "key": "a",
                    "text": "2",
                    "feedback": "This repeats one addend."
                  },
                  {
                    "key": "b",
                    "text": "4",
                    "feedback": "Adding the two values gives 4."
                  },
                  {
                    "key": "c",
                    "text": "6",
                    "feedback": "Check the two supplied addends."
                  },
                  {
                    "key": "d",
                    "text": "8",
                    "feedback": "This doubles the sum."
                  }
                ],
                "correct": "b"
              },
              "hints": [],
              "explanation": "The sum is 4."
            },
            {
              "key": "paper",
              "purpose": "Demonstrate optional open-response comparison.",
              "prompt": "Explain the sum on paper or in the optional response box.",
              "check": {
                "kind": "self_check",
                "rubric": [
