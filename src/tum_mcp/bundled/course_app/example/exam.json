              "locator": "Question 2",
              "statement": [
                {
                  "kind": "text",
                  "title": "Question 2",
                  "sources": [
                    "demo-past-paper"
                  ],
                  "paragraphs": [
                    "Write `bfs(graph, start)`, which returns the nodes reachable from a start node in breadth-first order. `graph` maps each node to a list of its neighbours."
                  ]
                }
              ],
              "solution": {
                "answers": [
                  {
                    "blocks": [
                      {
                        "kind": "text",
                        "title": "Solution",
                        "sources": [
                          "demo-past-paper"
                        ],
                        "paragraphs": [
                          "Enqueue the start, then repeatedly dequeue and enqueue unvisited neighbours."
                        ]
                      },
                      {
                        "kind": "code",
                        "title": "Code",
                        "sources": [
                          "demo-past-paper"
                        ],
                        "language": "python",
                        "code": "from collections import deque\n\ndef bfs(graph, start):\n    \"\"\"Return the nodes reachable from start in breadth-first order.\"\"\"\n    seen = {start}\n    queue = deque([start])\n    order = []\n    while queue:\n        node = queue.popleft()\n        order.append(node)\n        for neighbour in graph[node]:\n            if neighbour not in seen:\n                seen.add(neighbour)\n                queue.append(neighbour)\n    return order\n",
                        "explanation": "A queue gives breadth-first order."
                      }
                    ]
                  }
                ]
              },
              "check": {
                "kind": "self_check",
                "format": "code",
                "language": "python",
                "starter_code": "from collections import deque\n\ndef bfs(graph, start):\n    \"\"\"Return the nodes reachable from start in breadth-first order.\"\"\"\n    # your code\n",
                "model_answer": "from collections import deque\n\ndef bfs(graph, start):\n    \"\"\"Return the nodes reachable from start in breadth-first order.\"\"\"\n    seen = {start}\n    queue = deque([start])\n    order = []\n    while queue:\n        node = queue.popleft()\n        order.append(node)\n        for neighbour in graph[node]:\n            if neighbour not in seen:\n                seen.add(neighbour)\n                queue.append(neighbour)\n    return order\n",
                "rubric": [
