              "locator": "Question 2",
              "statement": [
                {
                  "kind": "text",
                  "title": "Question 2",
                  "sources": [
                    "demo-past-paper"
                  ],
                  "paragraphs": [
                    "Order the steps of breadth-first search from a start node."
                  ]
                }
              ],
              "solution": {
                "blocks": [
                  {
                    "kind": "text",
                    "title": "Solution",
                    "sources": [
                      "demo-past-paper"
                    ],
                    "paragraphs": [
                      "Enqueue the start, then repeatedly dequeue and enqueue unvisited neighbours."
                    ]
                  }
                ]
              },
              "check": {
                "kind": "order",
                "items": [
                  {
                    "key": "a",
                    "text": "Mark the start visited and enqueue it."
                  },
                  {
                    "key": "b",
                    "text": "Dequeue the next node."
                  },
                  {
                    "key": "c",
                    "text": "Enqueue each unvisited neighbour and mark it."
                  },
                  {
                    "key": "d",
                    "text": "Push the start on a stack."
                  }
                ],
                "answers": [
                  [
                    "a",
                    "b",
                    "c"
                  ]
                ],
                "feedback": "BFS uses a queue, so the oldest discovered node is expanded first."
              },
              "marking": [
                {
                  "text": "Correct order",
                  "points": 8,
                  "auto": true
                }
              ],
              "marking_basis": "authored"
            }
          ]
        }
      ]
    }
