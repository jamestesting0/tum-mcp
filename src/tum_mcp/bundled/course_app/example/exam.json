                  "title": "Question 1",
                  "sources": [
                    "demo-past-paper"
                  ],
                  "paragraphs": [
                    "A queue serves requests in arrival order. Name the data structure and give the cost of enqueue and dequeue."
                  ]
                }
              ],
              "solution": {
                "blocks": [
                  {
                    "kind": "text",
                    "title": "Solution",
                    "sources": [
                      "demo-past-paper"
                    ],
                    "paragraphs": [
                      "A queue (FIFO); both operations take O(1) with a linked list or ring buffer."
                    ]
                  }
                ]
              },
              "guidance": {
                "objectives": [
                  "Match an access rule to a structure."
                ],
                "steps": [
                  {
                    "key": "rule",
                    "purpose": "Name the rule",
                    "prompt": "Which removal rule does the scenario describe?",
                    "hints": [
                      "Who is served first?"
                    ],
                    "check": {
                      "kind": "text",
                      "accepted": [
                        "FIFO",
                        "first in first out",
                        "first-in first-out"
                      ],
                      "case_sensitive": false,
                      "feedback": "Arrival order means the oldest item leaves first."
                    },
                    "explanation": "First in, first out: a queue."
                  }
                ]
              },
              "marking": [
                {
                  "text": "Names a queue",
                  "points": 4
                },
                {
                  "text": "Both costs O(1)",
                  "points": 6
                }
              ],
              "marking_basis": "authored"
            },
            {
