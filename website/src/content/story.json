    {
      "key": "sync-run",
      "chapter": "sync",
      "weight": 0.67,
      "caption": {
        "title": "Sync a course",
        "line": "Sources land in materials/, with a course handbook."
      },
      "focus": "chat",
      "folder": true,
      "editor": "AGENTS.md",
      "chat": {
        "send": "{command}",
        "messages": [
          {
            "role": "tool",
            "kind": "mcp",
            "name": "moodle_list_courses",
            "detail": "current semester",
            "result": "Graph Search"
          },
          {
            "role": "tool",
            "kind": "mcp",
            "name": "moodle_list_course_materials",
            "detail": "Graph Search",
            "result": "6 materials"
          },
          {
            "role": "tool",
            "kind": "shell",
            "name": "tum-mcp study init . --course \"Graph Search\"",
            "result": "6 imported"
          },
          {
            "role": "agent",
            "text": "Graph Search is set up with 6 sources in materials/ and a handbook in .tum-mcp/course.md. Keep a private learning record of your attempts for this course?"
          }
        ],
        "files": [
          "AGENTS.md",
          "materials/content/material-lecture-01.md",
          "materials/content/material-lecture-02.md",
          "materials/content/material-lecture-03.md",
          "materials/content/material-recording-02.md",
          "materials/exercises/material-sheet-01.md",
          "materials/exams/material-past-paper.md",
          ".tum-mcp/course.md"
        ]
      }
    },
