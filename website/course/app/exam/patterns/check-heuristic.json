{
  "key": "check-heuristic",
  "topic": "informed",
  "title": "Check a heuristic",
  "summary": "Decide whether a heuristic is admissible, consistent, or neither.",
  "cues": [
    "A table of h values and a question about optimality"
  ],
  "workflow": [
    {
      "do": "Decide what is asked",
      "why": "The two properties need different comparisons.",
      "cases": [
        {
          "when": "Admissible is asked",
          "then": "Compare each h(v) with the true cost to the goal",
          "apply": {
            "math": [
              "h(v) \\le d(v, \\text{goal})"
            ],
            "symbols": [
              {
                "symbol": "\\(h(v)\\)",
                "meaning": "Estimate from v to the goal"
              },
              {
                "symbol": "\\(d(v, \\text{goal})\\)",
                "meaning": "True least cost from v to the goal"
              }
            ]
          }
        },
        {
          "when": "Consistent is asked",
          "then": "Check every edge",
          "apply": {
            "math": [
              "h(u) \\le w(u, v) + h(v)"
            ],
            "symbols": [
              {
                "symbol": "\\(w(u, v)\\)",
                "meaning": "Weight of the edge from u to v"
              },
              {
                "symbol": "\\(h(u)\\)",
                "meaning": "Estimate at the edge start"
              }
            ]
          }
        }
      ]
    },
    {
      "do": "Find one violation or confirm all",
      "why": "One violation is enough to say no.",
      "apply": {
        "text": "Name the vertex or edge that fails, with both numbers."
      }
    }
  ],
  "concepts": [
    "admissible",
    "consistent"
  ],
  "sources": [
    {
      "key": "past-paper",
      "sha256": "cb9e17da9966983c605ed182558f55aa74b4bd52d75c89822eedfbaafa09d1eb"
    }
  ],
  "examples": [
    {
