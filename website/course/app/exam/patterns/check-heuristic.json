        {
          "kind": "text",
          "title": "Task",
          "sources": [
            "past-paper"
          ],
          "paragraphs": [
            "Is the heuristic admissible? True costs to \\(G\\): \\(A\\) 6, \\(B\\) 3, \\(D\\) 1."
          ]
        },
        {
          "kind": "table",
          "title": "Heuristic",
          "sources": [
            "past-paper"
          ],
          "columns": [
            "Vertex",
            "\\(h(v)\\)"
          ],
          "rows": [
            [
              "\\(A\\)",
              "\\(5\\)"
            ],
            [
              "\\(B\\)",
              "\\(4\\)"
            ],
            [
              "\\(D\\)",
              "\\(1\\)"
            ]
          ],
          "caption": "Estimates to G."
        }
      ],
      "solution": {
        "answers": [
          {
            "blocks": [
              {
                "kind": "text",
                "title": "Solution",
                "sources": [
                  "past-paper"
                ],
                "paragraphs": [
                  "Not admissible: \\(h(B) = 4 > 3\\)."
                ]
              }
            ]
          }
        ]
      },
      "steps": [
        {
          "step": 1,
          "prompt": "Which property is asked?",
          "case": 1,
          "case_feedback": [
            "Yes: compare each estimate with its true cost.",
            "Consistency is about edges; this question asks about true costs."
          ],
          "answer": [
            {
              "kind": "text",
              "title": "Case",
              "sources": [
                "past-paper"
              ],
              "paragraphs": [
                "Admissible."
              ]
            }
          ]
        },
        {
          "step": 2,
          "prompt": "Which vertex violates it?",
          "check": {
            "kind": "text",
            "answer": "B",
            "feedback": "\\(4 > 3\\)."
          },
          "answer": [
            {
              "kind": "text",
              "title": "Violation",
              "sources": [
                "past-paper"
              ],
              "paragraphs": [
                "\\(h(B) = 4 > 3\\)."
              ]
            }
          ]
        }
      ]
    },
    {
      "blocks": [
        {
          "kind": "text",
          "title": "Task",
          "sources": [
            "past-paper"
          ],
          "paragraphs": [
            "Is the heuristic consistent on the edge between \\(B\\) and \\(C\\)?"
          ]
        },
        {
          "kind": "table",
          "title": "Edge",
          "sources": [
            "past-paper"
          ],
          "columns": [
            "\\(w(B, C)\\)",
            "\\(h(B)\\)",
            "\\(h(C)\\)"
          ],
          "rows": [
            [
              "\\(1\\)",
              "\\(3\\)",
              "\\(3\\)"
            ]
          ],
          "caption": "An undirected edge: check both directions."
        }
      ],
      "solution": {
        "answers": [
          {
            "blocks": [
              {
                "kind": "text",
                "title": "Solution",
                "sources": [
                  "past-paper"
                ],
                "paragraphs": [
                  "Yes in both directions: \\(3 \\le 1 + 3\\)."
                ]
              }
            ]
          }
        ]
      },
      "steps": [
        {
          "step": 1,
          "prompt": "Which property is asked?",
          "case": 2,
          "case_feedback": [
            "Admissibility compares with true costs; this question names an edge.",
            "Yes: check the edge inequality in both directions."
          ],
          "answer": [
            {
              "kind": "text",
              "title": "Case",
              "sources": [
                "past-paper"
              ],
              "paragraphs": [
                "Consistent."
              ]
            }
          ]
        },
        {
          "step": 2,
          "prompt": "Does \\(h(B) \\le w(B, C) + h(C)\\) hold?",
          "check": {
            "kind": "text",
            "answer": "yes",
            "feedback": "\\(3 \\le 4\\)."
          },
          "answer": [
            {
              "kind": "text",
              "title": "Check",
              "sources": [
                "past-paper"
              ],
              "paragraphs": [
                "\\(3 \\le 1 + 3 = 4\\); the reverse direction gives the same numbers."
              ]
            }
          ]
        }
      ]
    }
  ],
  "pitfalls": [
    {
      "situation": "Reading \\(h(D) = 0\\) as a violation.",
      "wrong": "An estimate below the true cost breaks admissibility.",
      "right": "Only an estimate above the true cost breaks it.",
      "why": "Admissible means never overestimating.",
      "step": 2
    }
  ],
