{
  "key": "trace-dijkstra",
  "topic": "weighted",
  "title": "Trace Dijkstra",
  "summary": "Fill the table of tentative distances and read off the path.",
  "cues": [
    "A weighted graph and a table of tentative distances"
  ],
  "workflow": [
    {
      "do": "Start the table",
      "why": "Every later value comes from this row.",
      "apply": {
        "text": "Source \\(0\\), every other vertex \\(\\infty\\)."
      }
    },
    {
      "do": "Settle the smallest open value",
      "why": "With non-negative weights it can no longer improve.",
      "apply": {
        "text": "Circle it in the table; it never changes again."
      }
    },
    {
      "do": "Relax its edges",
      "why": "Only edges out of the settled vertex can change values now.",
      "apply": {
        "math": [
          "d(v) \\gets \\min(d(v),\\ d(u) + w(u, v))"
        ],
        "symbols": [
          {
            "symbol": "\\(u\\)",
            "meaning": "The vertex just settled"
          },
          {
            "symbol": "\\(v\\)",
            "meaning": "One of its neighbours"
          }
        ]
      }
    },
    {
      "do": "Read the path from the parents",
      "why": "Each decrease recorded the vertex it came through.",
      "apply": {
        "text": "Walk back from the target to the source, then reverse."
      }
    }
  ],
  "concepts": [
    "relaxation",
    "dijkstra-loop"
  ],
