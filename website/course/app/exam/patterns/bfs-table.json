{
  "key": "bfs-table",
  "topic": "unweighted",
  "title": "BFS distances and parents",
  "summary": "Run the queue and fill one row per vertex.",
  "cues": [
    "An unweighted graph and a request for distances or parents"
  ],
  "workflow": [
    {
      "do": "Start the queue with the source",
      "why": "The source is layer 0.",
      "apply": {
        "text": "Distance \\(0\\), no parent."
      }
    },
    {
      "do": "Remove the front, append its unmarked neighbours",
      "why": "FIFO keeps the layers in order.",
      "apply": {
        "text": "Each appended vertex gets distance plus one and the removed vertex as parent; mark it now."
      }
    },
    {
      "do": "Fill the table when the queue is empty",
      "why": "Every reachable vertex has been appended exactly once.",
      "apply": {
        "text": "One row per vertex: distance and parent."
      }
    }
  ],
