              "locator": "Question 3",
              "statement": [
                {
                  "kind": "text",
                  "title": "Question 3",
                  "sources": [
                    "past-paper"
                  ],
                  "paragraphs": [
                    "Give a graph with one negative edge on which Dijkstra returns a wrong distance, and name the step that goes wrong."
                  ]
                }
              ],
              "solution": {
                "answers": [
                  {
                    "blocks": [
                      {
                        "kind": "text",
                        "title": "Solution",
                        "sources": [
                          "past-paper"
                        ],
                        "paragraphs": [
                          "\\(w(S, X) = 2\\), \\(w(S, Y) = 3\\), \\(w(Y, X) = -2\\): \\(X\\) is settled at \\(2\\) before \\(Y\\), but the path through \\(Y\\) costs \\(1\\)."
                        ]
                      }
                    ]
                  }
                ]
              },
              "guidance": {
                "objectives": [
                  "Build a counterexample for negative edges."
                ],
                "steps": [
                  {
                    "key": "settle-early",
                    "purpose": "Find the early settle",
                    "prompt": "With \\(w(S, X) = 2\\), \\(w(S, Y) = 3\\), \\(w(Y, X) = -2\\), which vertex is settled right after \\(S\\)?",
                    "hints": [
                      "Compare \\(2\\) and \\(3\\)."
                    ],
                    "check": {
                      "kind": "text",
                      "answer": "X",
                      "feedback": "\\(X\\) has \\(2\\), \\(Y\\) has \\(3\\)."
                    },
                    "explanation": "\\(X\\) is final at \\(2\\) before \\(Y\\) is settled."
                  },
                  {
                    "key": "true-cost",
                    "purpose": "Compare",
                    "prompt": "What does the path through \\(Y\\) cost?",
                    "hints": [
                      "Add \\(3\\) and \\(-2\\)."
                    ],
                    "check": {
                      "kind": "numeric",
                      "answer": 1,
                      "feedback": "\\(3 + (-2) = 1 < 2\\)."
                    },
                    "explanation": "\\(1 < 2\\), so the settled value was wrong."
                  }
                ]
              },
              "marking": [
                {
                  "text": "Valid graph",
                  "points": 2
                },
                {
                  "text": "Names the early settle",
                  "points": 2
                }
              ],
              "marking_basis": "authored"
            },
            {
              "key": "q4",
              "number": "4",
              "points": 6,
              "format": "short",
              "patterns": [
                "check-heuristic"
              ],
              "concepts": [
                "consistent",
                "admissible"
              ],
              "locator": "Question 4",
              "statement": [
                {
                  "kind": "text",
                  "title": "Question 4",
                  "sources": [
                    "past-paper"
                  ],
                  "paragraphs": [
                    "A heuristic satisfies \\(h(u) \\le w(u, v) + h(v)\\) for every edge and \\(h(\\text{goal}) = 0\\). Show that it is admissible."
                  ]
                }
              ],
              "solution": {
                "answers": [
                  {
                    "blocks": [
                      {
                        "kind": "text",
                        "title": "Solution",
                        "sources": [
                          "past-paper"
                        ],
                        "paragraphs": [
                          "Sum the inequality along a shortest path from \\(v\\) to the goal; the weights add up to \\(d(v, \\text{goal})\\) and the inner \\(h\\) terms cancel, leaving \\(h(v) \\le d(v, \\text{goal})\\)."
                        ]
                      }
                    ]
                  }
                ]
              },
              "guidance": {
                "objectives": [
                  "Prove that consistency implies admissibility."
                ],
                "steps": [
                  {
                    "key": "path",
                    "purpose": "Pick the path",
                    "prompt": "Which path from \\(v\\) to the goal do you sum along?",
                    "hints": [
                      "Its total weight is the true cost."
                    ],
                    "check": {
                      "kind": "text",
                      "answer": "a shortest path",
                      "feedback": "Its weights sum to \\(d(v, \\text{goal})\\)."
                    },
                    "explanation": "Take a shortest path \\(v = v_0, v_1, \\ldots, v_k = \\text{goal}\\)."
                  },
                  {
                    "key": "telescope",
                    "purpose": "Sum the edges",
                    "prompt": "Summing \\(h(v_i) \\le w(v_i, v_{i+1}) + h(v_{i+1})\\) over the path gives what?",
                    "hints": [
                      "The inner \\(h\\) terms cancel and \\(h(\\text{goal}) = 0\\)."
                    ],
                    "check": {
                      "kind": "text",
                      "answer": "h(v) <= d(v, goal)",
                      "feedback": "The weights add up to the true cost."
                    },
                    "explanation": "\\(h(v) \\le d(v, \\text{goal})\\): admissible."
                  }
                ]
              },
              "marking": [
                {
                  "text": "Uses a shortest path",
                  "points": 2
                },
                {
                  "text": "Telescopes the inequality",
                  "points": 4
                }
              ],
              "marking_basis": "authored"
            }
          ]
        }
