                  "kind": "text",
                  "title": "Question 1",
                  "sources": [
                    "past-paper"
                  ],
                  "paragraphs": [
                    "Run BFS from \\(S\\) on \\(S\\)–\\(A\\), \\(S\\)–\\(B\\), \\(A\\)–\\(C\\), \\(B\\)–\\(C\\), \\(C\\)–\\(D\\). Give the distance and parent of every vertex."
                  ]
                }
              ],
              "solution": {
                "answers": [
                  {
                    "blocks": [
                      {
                        "kind": "table",
                        "title": "Solution",
                        "sources": [
                          "past-paper"
                        ],
                        "columns": [
                          "Vertex",
                          "Distance",
                          "Parent"
                        ],
                        "rows": [
                          [
                            "\\(A\\)",
                            "\\(1\\)",
                            "\\(S\\)"
                          ],
                          [
                            "\\(B\\)",
