                  {
                    "blocks": [
                      {
                        "kind": "text",
                        "title": "Solution",
                        "sources": [
                          "past-paper"
                        ],
                        "paragraphs": [
                          "Settle \\(S, B, A, C\\) at \\(0, 1, 3, 4\\). Path \\(S \\to B \\to A \\to C\\), cost \\(4\\)."
                        ]
                      }
                    ]
                  }
                ]
