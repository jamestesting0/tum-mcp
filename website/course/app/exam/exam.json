              "guidance": {
                "objectives": [
                  "Trace Dijkstra in a table."
                ],
                "steps": [
                  {
                    "key": "first",
                    "purpose": "First settle",
                    "prompt": "Which vertex is settled after \\(S\\)?",
                    "hints": [
                      "Compare \\(A = 4\\) and \\(B = 1\\)."
                    ],
                    "check": {
                      "kind": "text",
                      "answer": "B",
                      "feedback": "\\(B\\) has the smallest open value."
                    },
                    "explanation": "\\(B\\) at \\(1\\)."
                  },
                  {
                    "key": "improve-a",
                    "purpose": "Relax through B",
                    "prompt": "What does relaxing \\(B\\) give \\(A\\)?",
                    "hints": [
                      "Compare \\(4\\) with \\(1 + 2\\)."
                    ],
                    "check": {
                      "kind": "numeric",
                      "answer": 3,
                      "feedback": "\\(1 + 2 = 3 < 4\\)."
                    },
                    "explanation": "\\(A = 3\\) with parent \\(B\\)."
                  },
                  {
                    "key": "cost-c",
                    "purpose": "Finish",
                    "prompt": "What is \\(d(C)\\)?",
                    "hints": [
                      "Settle \\(A\\), then relax its edge to \\(C\\)."
                    ],
                    "check": {
                      "kind": "numeric",
                      "answer": 4,
                      "feedback": "\\(3 + 1 = 4 < 6\\)."
                    },
                    "explanation": "Path \\(S \\to B \\to A \\to C\\)."
                  }
                ]
              },
