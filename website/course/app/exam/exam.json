                          ],
                          [
                            "\\(D\\)",
                            "\\(3\\)",
                            "\\(C\\)"
                          ]
                        ],
                        "caption": "Neighbours appended alphabetically."
                      }
                    ]
                  }
                ]
              },
              "guidance": {
                "objectives": [
                  "Fill a BFS table from the queue."
                ],
                "steps": [
                  {
                    "key": "layer-one",
                    "purpose": "Layer 1",
                    "prompt": "Remove \\(S\\). Which vertices are appended?",
                    "hints": [
                      "Both neighbours of \\(S\\), alphabetically."
                    ],
                    "check": {
                      "kind": "text",
                      "answer": "A, B",
                      "feedback": "Distance \\(1\\), parent \\(S\\)."
                    },
                    "explanation": "\\(A\\) and \\(B\\) get distance \\(1\\)."
                  },
                  {
                    "key": "parent-c",
                    "purpose": "First discovery",
                    "prompt": "Who appends \\(C\\)?",
                    "hints": [
                      "\\(A\\) leaves the queue before \\(B\\)."
                    ],
                    "check": {
                      "kind": "text",
                      "answer": "A",
                      "feedback": "\\(A\\) is removed first and marks \\(C\\)."
                    },
                    "explanation": "\\(C\\) gets parent \\(A\\), distance \\(2\\)."
                  },
                  {
                    "key": "distance-d",
                    "purpose": "Last layer",
                    "prompt": "What is the distance of \\(D\\)?",
                    "hints": [
                      "\\(D\\) is a neighbour of \\(C\\) only."
                    ],
                    "check": {
                      "kind": "numeric",
                      "answer": 3,
                      "feedback": "\\(d(C) + 1 = 3\\)."
                    },
                    "explanation": "\\(d(D) = 3\\), parent \\(C\\)."
                  }
                ]
              },
              "marking": [
                {
                  "text": "Distances",
                  "points": 3
                },
                {
                  "text": "Parents",
                  "points": 3
                }
              ],
