      "purpose": "Why marking on append matters.",
      "prompt": "Why does \\(R\\) not append \\(T\\) again?",
      "check": {
        "kind": "choice",
        "correct": "a",
        "options": [
          {
            "key": "a",
            "text": "\\(T\\) was marked when \\(Q\\) appended it.",
            "feedback": "Correct: the mark is set on append, before R is removed."
          },
          {
            "key": "b",
            "text": "\\(T\\) has already left the queue.",
            "feedback": "\\(T\\) is still waiting when \\(R\\) is removed."
          },
          {
            "key": "c",
            "text": "\\(R\\) is not adjacent to \\(T\\).",
            "feedback": "The edge \\(R\\)–\\(T\\) exists."
          },
          {
            "key": "d",
            "text": "\\(T\\) is further from \\(P\\) than \\(R\\).",
            "feedback": "Distance alone does not stop a vertex from being appended."
          }
        ]
      },
      "hints": [
        "When is a vertex marked?"
      ],
      "explanation": "\\(T\\) enters once because \\(Q\\) marked it on append."
    }
