      "title": "Expand by estimated total cost",
      "level": 1,
      "sources": [
        "lecture-03"
      ],
      "latex": "f(v) = g(v) + h(v)",
      "plain": "Cost so far plus estimated cost still to go.",
      "symbols": [
        {
          "symbol": "\\(g(v)\\)",
          "meaning": "Best known cost from the start"
        },
        {
          "symbol": "\\(h(v)\\)",
          "meaning": "Estimated cost from v to the goal"
        }
      ],
      "conditions": "A* always expands the open vertex with the smallest \\(f\\)."
    },
