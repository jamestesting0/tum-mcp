    {
      "kind": "definition",
      "key": "admissible",
      "sources": [
        "lecture-03"
      ],
      "term": "Admissible heuristic",
      "statement": "\\(h(v) \\le d(v, \\text{goal})\\) for every vertex \\(v\\): it never overestimates.",
      "conditions": [
        "With it, A* returns an optimal path."
      ]
    },
    {
      "kind": "definition",
      "key": "consistent",
      "sources": [
        "lecture-03"
      ],
      "term": "Consistent heuristic",
      "statement": "\\(h(u) \\le w(u, v) + h(v)\\) for every edge \\((u, v)\\), and \\(h(\\text{goal}) = 0\\).",
      "conditions": [
        "Consistent implies admissible.",
        "A* then never reopens a vertex."
      ]
    },
