{
  "key": "astar",
  "label": "Lecture 3",
  "title": "A* search",
  "minutes": 18,
  "summary": "Aim the search at a goal with a heuristic that never overestimates.",
  "objectives": [
    {
      "key": "score",
      "text": "Compute \\(f = g + h\\) for open vertices."
    },
    {
      "key": "admissible",
      "text": "Check whether a heuristic is admissible and consistent."
    },
    {
      "key": "trace",
      "text": "Trace A* and compare it with Dijkstra."
    }
  ],
  "sources": [
    {
      "key": "lecture-03",
