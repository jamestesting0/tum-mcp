      "key": "negative-edge",
      "objective": "negative",
      "level": "reason",
      "prompt": "Dijkstra runs from \\(S\\) on this graph and reports \\(d(X) = 2\\). Why is that wrong?",
      "options": [
        {
          "key": "a",
          "text": "\\(X\\) is settled before the cheaper path through \\(Y\\) is found.",
          "feedback": "Correct: the negative edge arrives after the value is final."
        },
        {
          "key": "b",
          "text": "Dijkstra skips every negative edge it meets.",
          "feedback": "It relaxes them, but only after the target is settled."
        },
        {
          "key": "c",
          "text": "\\(Y\\) is settled before \\(X\\) is settled.",
          "feedback": "\\(X\\) has the smaller tentative distance, so it is settled first."
        },
        {
          "key": "d",
          "text": "The priority queue breaks a tie the wrong way.",
          "feedback": "There is no tie: \\(2\\) and \\(3\\) differ."
        }
      ],
      "correct": "a",
      "explanation": "\\(3 + (-2) = 1 < 2\\), but \\(X\\) was settled at 2 and is never revisited.",
