  "questions": [
    {
      "key": "relax-cb",
      "objective": "relax",
      "level": "apply",
      "prompt": "\\(C\\) is being settled. What does relaxing the edge from \\(C\\) to \\(B\\) give?",
      "options": [
        {
          "key": "a",
          "text": "\\(d(B) = 5\\), parent \\(C\\)",
          "feedback": "\\(4 + 1 = 5 < 6\\), so the route through \\(C\\) replaces the old one."
        },
        {
          "key": "b",
          "text": "\\(d(B) = 6\\), unchanged",
          "feedback": "\\(4 + 1 = 5\\) is smaller than 6, so the value does change."
        },
        {
          "key": "c",
          "text": "\\(d(B) = 7\\)",
          "feedback": "This adds the weight to the old value; relaxation never increases a distance."
        },
        {
          "key": "d",
          "text": "\\(d(C) = 7\\)",
          "feedback": "Relaxing the edge from \\(C\\) updates \\(B\\), not \\(C\\)."
        }
      ],
      "correct": "a",
      "explanation": "\\(\\min(6, 4 + 1) = 5\\), and \\(C\\) becomes the parent of \\(B\\).",
      "hint": "Compute \\(d(C) + w(C, B)\\) and compare.",
      "sources": [
