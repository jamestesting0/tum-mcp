  "blocks": [
    {
      "kind": "text",
      "title": "Distance by weight",
      "level": 1,
      "sources": [
        "lecture-02"
      ],
      "paragraphs": [
        "Each edge now carries a weight \\(w(u, v) \\ge 0\\). The distance \\(d(s, v)\\) is the least total weight of a path from \\(s\\) to \\(v\\)."
      ]
    },
    {
      "kind": "formula",
      "title": "Relaxation",
      "level": 1,
      "sources": [
        "lecture-02"
      ],
      "latex": "d(v) \\gets \\min\\bigl(d(v),\\; d(u) + w(u, v)\\bigr)",
      "plain": "Keep the shorter of the known route to \\(v\\) and the route through \\(u\\).",
      "symbols": [
        {
          "symbol": "\\(d(v)\\)",
          "meaning": "Tentative distance of v"
        },
        {
          "symbol": "\\(w(u, v)\\)",
          "meaning": "Weight of the edge from u to v"
        }
      ],
      "conditions": "When \\(d(v)\\) decreases, \\(u\\) becomes the parent of \\(v\\)."
    },
    {
      "kind": "text",
      "title": "The loop",
      "level": 1,
      "sources": [
        "lecture-02"
      ],
      "paragraphs": [
        "Every vertex starts unsettled. Then:"
      ],
      "steps": [
        "Start: give the source distance \\(0\\) and every other vertex \\(\\infty\\).",
        "Choose: the unsettled vertex with the smallest tentative distance.",
        "Settle: fix its distance.",
        "Relax: try every edge leaving it."
      ]
    },
