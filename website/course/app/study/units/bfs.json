        "lecture-01"
      ],
      "paragraphs": [
        "In an unweighted graph every edge counts as one step."
      ]
    },
    {
      "kind": "definition",
      "key": "edge-distance",
      "sources": [
        "lecture-01"
      ],
      "term": "Distance (unweighted)",
      "statement": "\\(d(s, v)\\) is the least number of edges on any path from \\(s\\) to \\(v\\).",
      "conditions": [
        "\\(d(s, s) = 0\\).",
        "A vertex with no path from \\(s\\) has distance \\(\\infty\\)."
      ]
    },
