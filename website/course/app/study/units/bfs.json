    {
      "kind": "callout",
      "tone": "pitfall",
      "sources": [
        "lecture-01"
      ],
      "situation": "Tracing BFS by hand and marking a vertex only when it leaves the queue.",
      "wrong": "\\(A\\) and \\(B\\) both append \\(C\\): the queue holds \\(C\\) twice.",
      "right": "Mark \\(C\\) when \\(A\\) appends it; \\(B\\) sees the mark and skips it.",
      "why": "Marking on append keeps each vertex in the queue once, so the run stays linear."
    },
