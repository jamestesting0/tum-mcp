{
  "key": "bfs",
  "label": "Lecture 1",
  "title": "Breadth-first search",
  "minutes": 15,
  "summary": "Shortest paths by edge count, one layer at a time.",
  "objectives": [
    {
      "key": "layers",
      "text": "Compute BFS distances layer by layer."
    },
    {
      "key": "queue",
      "text": "Explain why a FIFO queue processes the layers in order."
    },
    {
      "key": "mark",
      "text": "Mark vertices when they are appended, and say what goes wrong otherwise."
    }
  ],
