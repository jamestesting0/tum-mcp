    {
      "kind": "text",
      "title": "Build the layers",
      "level": 1,
      "sources": [
        "lecture-01"
      ],
      "paragraphs": [
        "Each layer is built from the one before it."
      ],
      "steps": [
        "Start: layer 0 holds only \\(s\\).",
        "Grow: layer \\(k + 1\\) holds every undiscovered neighbour of layer \\(k\\).",
        "Stop: no layer adds a new vertex. A vertex in layer \\(k\\) is \\(k\\) edges from \\(s\\)."
      ]
    },
