    {
      "key": "why-fifo",
      "objective": "queue",
      "level": "reason",
      "prompt": "The queue after removing \\(A\\) holds \\(B\\), \\(E\\), \\(C\\). Why is \\(C\\) removed after \\(B\\) and \\(E\\)?",
      "options": [
        {
          "key": "a",
          "text": "\\(C\\) was appended last, and FIFO removes in append order.",
          "feedback": "Correct: append order is layer order, and a FIFO queue keeps it."
        },
        {
          "key": "b",
          "text": "BFS sorts the queue by distance after each step.",
          "feedback": "There is no sorting; the order comes from FIFO alone."
        },
        {
          "key": "c",
          "text": "\\(C\\) has more neighbours than \\(B\\) or \\(E\\).",
          "feedback": "The number of neighbours does not change the queue order."
        },
        {
          "key": "d",
          "text": "Vertices are removed in alphabetical order.",
          "feedback": "Alphabetical order would remove \\(C\\) before \\(E\\)."
        }
      ],
      "correct": "a",
      "explanation": "Vertices of layer 2 are appended behind every layer-1 vertex, and a FIFO queue never lets them overtake.",
      "hint": "Look at the queue after removing A.",
