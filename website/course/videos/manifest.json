      "beats": [
        {
          "key": "b01",
          "chapter": "c01",
          "start": 0.0,
          "duration": 11.011,
          "cues": [
            {
              "start": 0.25,
              "end": 5.029,
              "text": "Dijkstra's algorithm finds the cheapest path when every edge has a weight.",
              "audio": "b01_01-b6525e9f85.wav"
            },
            {
              "start": 5.329,
              "end": 10.811,
              "text": "It repeats two moves: settle the closest vertex, then relax the edges that leave it.",
              "audio": "b01_02-b5242f3b68.wav"
            }
          ]
        },
        {
          "key": "b02",
          "chapter": "c02",
          "start": 11.011,
          "duration": 16.175,
          "cues": [
            {
              "start": 11.261,
              "end": 15.08,
              "text": "Vertex C is settled at four, and vertex B still has six.",
              "audio": "b02_01-3072329152.wav"
            },
            {
              "start": 15.38,
              "end": 21.204,
              "text": "The edge from C to B weighs one, so the route through C costs four plus one, which is five.",
              "audio": "b02_02-7588133ecb.wav"
            },
            {
              "start": 21.504,
              "end": 26.987,
              "text": "Five beats six, so relaxation lowers B to five and records C as its parent.",
              "audio": "b02_03-6284ab01ef.wav"
            }
          ]
        },
        {
          "key": "b03",
          "chapter": "c03",
          "start": 27.187,
          "duration": 18.097,
          "cues": [
            {
              "start": 27.437,
              "end": 29.421,
              "text": "Start at S with distance zero.",
              "audio": "b03_01-f01ab72c7f.wav"
            },
            {
              "start": 29.721,
              "end": 34.99,
              "text": "Each time, settle the smallest open value: S, then E at one, then A at two.",
              "audio": "b03_02-33cbf32d1f.wav"
            },
            {
              "start": 35.29,
              "end": 40.154,
              "text": "Settling C at four lowers B from six to five and opens G at nine.",
              "audio": "b03_03-dde18a8594.wav"
            },
            {
              "start": 40.454,
              "end": 45.083,
              "text": "B gives D seven, and D lowers G to eight, the cheapest cost to G.",
              "audio": "b03_04-cb98cd8abc.wav"
            }
          ]
        },
        {
          "key": "b04",
          "chapter": "c04",
          "start": 45.283,
          "duration": 17.179,
          "cues": [
            {
              "start": 45.533,
              "end": 48.392,
              "text": "This only works when no edge weight is negative.",
              "audio": "b04_01-853463138a.wav"
            },
            {
              "start": 48.692,
              "end": 51.892,
              "text": "Here X is settled at two before Y is looked at.",
              "audio": "b04_02-94f093b033.wav"
            },
            {
              "start": 52.192,
              "end": 57.525,
              "text": "But Y costs three, and its edge to X weighs minus two, so X really costs one.",
              "audio": "b04_03-8815073670.wav"
            },
            {
              "start": 57.825,
              "end": 62.263,
              "text": "A settled value is final, so Dijkstra keeps the wrong distance of two.",
              "audio": "b04_04-faab014ee4.wav"
            }
          ]
        },
        {
          "key": "b05",
          "chapter": "c04",
          "start": 62.463,
          "duration": 6.999,
          "cues": [
            {
              "start": 62.713,
              "end": 69.262,
              "text": "So: settle the smallest tentative distance, relax its edges, and keep every weight non-negative.",
              "audio": "b05_01-e8be02adcd.wav"
            }
          ]
        }
      ],
