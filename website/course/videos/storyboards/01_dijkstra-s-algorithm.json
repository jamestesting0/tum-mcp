    {
      "key": "c03",
      "title": "Settle in order",
      "beats": [
        {
          "key": "b03",
          "kind": "instance",
          "intent": "Trace the running example so the settle order and the two improvements are visible.",
          "narration": [
            "Start at S with distance zero.",
            "Each time, settle the smallest open value: S, then E at one, then A at two.",
            "Settling C at four lowers B from six to five and opens G at nine.",
            "B gives D seven, and D lowers G to eight, the cheapest cost to G."
          ],
