              "key": "rule",
              "kind": "math",
              "typst": "d(v) <- min(d(v), d(u) + w(u, v))",
              "source_latex": "d(v) \\gets \\min\\bigl(d(v),\\; d(u) + w(u, v)\\bigr)"
