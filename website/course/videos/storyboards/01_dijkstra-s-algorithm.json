    {
      "key": "c02",
      "title": "Relaxation",
      "beats": [
        {
          "key": "b02",
          "kind": "mechanism",
          "intent": "Show one relaxation lowering a tentative distance, with the rule beside it.",
          "narration": [
            "Vertex C is settled at four, and vertex B still has six.",
            "The edge from C to B weighs one, so the route through C costs four plus one, which is five.",
            "Five beats six, so relaxation lowers B to five and records C as its parent."
          ],
          "on_screen": [
            {
              "key": "c",
              "kind": "label",
