    {
      "key": "c04",
      "title": "When it fails",
      "beats": [
        {
          "key": "b04",
          "kind": "pitfall",
          "intent": "Show why a negative edge breaks the settled order.",
          "narration": [
            "This only works when no edge weight is negative.",
            "Here X is settled at two before Y is looked at.",
            "But Y costs three, and its edge to X weighs minus two, so X really costs one.",
            "A settled value is final, so Dijkstra keeps the wrong distance of two."
          ],
