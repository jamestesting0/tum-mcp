        {
          "key": "h-second",
          "title": "Mark a vertex when it enters the queue",
          "interval": {
            "start_s": 120,
            "end_s": 180
          },
          "teaches": "Marking at enqueue time keeps every vertex in the queue once, so BFS runs in \\(O(V+E)\\).",
          "points": [
            "Marking at dequeue time lets a vertex enter once per incoming edge."
