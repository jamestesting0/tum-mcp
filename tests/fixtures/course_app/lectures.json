      "highlights": [
        {
          "key": "h-first",
          "title": "Why first discovery gives a shortest path",
          "interval": {
            "start_s": 20,
            "end_s": 60
          },
          "teaches": "BFS reaches each vertex first along a path with the fewest edges, because the queue holds only distances \\(d\\) and \\(d+1\\).",
          "points": [
            "Removing a vertex at distance \\(d\\) gives each new neighbour distance \\(d+1\\).",
            "On the path \\(A\\)–\\(B\\)–\\(C\\) the distances from \\(A\\) are \\(0\\), \\(1\\) and \\(2\\)."
          ],
          "sources": [
