              "kind": "text",
              "title": "The task",
              "sources": [
                "weighted"
              ],
              "paragraphs": [
                "Implement `increment()` in `Counter.java` so that `Main` prints 1."
              ]
            },
            {
              "kind": "files",
              "title": "Exercise files",
              "sources": [
                "weighted"
              ],
              "key": "counter",
              "description": "A Counter class to complete and the Main class that uses it.",
              "open": "src/Counter.java",
              "files": [
                {
                  "path": "src/Counter.java",
                  "code": "public class Counter {\n    private int count;\n\n    public void increment() {\n        // TODO: add one\n    }\n\n    public int value() {\n        return count;\n    }\n}\n",
                  "editable": true
                },
                {
                  "path": "src/Main.java",
                  "code": "public class Main {\n    public static void main(String[] args) {\n        Counter counter = new Counter();\n        counter.increment();\n        System.out.println(counter.value()); // 1\n    }\n}\n"
                }
              ]
            }
          ],
          "objectives": [
            "Change a field through a method."
          ],
