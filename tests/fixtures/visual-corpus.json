    {
      "kind": "uml",
      "title": "AC-3",
      "sources": [
        "graphs"
      ],
      "description": "AC-3 as a flowchart.",
      "steps": [
        {
          "key": "start",
          "kind": "start",
          "text": "Start"
        },
        {
          "key": "init",
          "kind": "action",
          "text": "Put every arc in the queue"
        },
        {
          "key": "empty",
          "kind": "decision",
          "text": "Queue empty?"
        },
        {
          "key": "pop",
          "kind": "action",
          "text": "Remove arc (X, Y)"
        },
        {
          "key": "revise",
          "kind": "action",
          "text": "Revise X against Y"
        },
        {
          "key": "changed",
          "kind": "decision",
          "text": "X changed?"
        },
        {
          "key": "none",
          "kind": "decision",
          "text": "X empty?"
        },
        {
          "key": "add",
          "kind": "action",
          "text": "Queue (Z, X) for each neighbour Z ≠ Y"
        },
        {
          "key": "ok",
          "kind": "end",
          "text": "Consistent"
        },
        {
          "key": "fail",
          "kind": "end",
          "text": "No solution"
        }
      ],
      "flows": [
        {
