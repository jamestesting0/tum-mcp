  "flashcards": [
    {
      "key": "degree",
      "objective": "model",
      "front": "What does the degree of a vertex count?",
      "back": "It counts the edges incident to that vertex.",
      "sources": [
        "graphs"
      ]
    },
    {
      "key": "double",
      "objective": "model",
      "front": "Why does the degree sum count each undirected edge twice?",
      "back": "Each edge has two endpoints. It contributes one to the degree of each endpoint.",
      "sources": [
        "graphs"
      ]
    },
    {
      "key": "sparse",
      "objective": "storage",
      "front": "Why does an adjacency list suit a sparse graph?",
      "back": "It stores existing neighbors. It avoids reserving a cell for every possible pair of vertices.",
      "sources": [
        "graphs"
      ]
    }
  ],
  "questions": [
    {
      "key": "degree-sum",
      "objective": "model",
      "prompt": "A simple undirected graph has six edges. What is the sum of all vertex degrees?",
      "level": "apply",
      "options": [
        {
          "key": "0",
          "text": "6",
          "feedback": "This counts each edge once. An edge contributes to two endpoint degrees."
        },
        {
          "key": "1",
          "text": "12",
          "feedback": "Each of the six edges contributes two to the degree sum."
        },
        {
          "key": "2",
          "text": "36",
          "feedback": "This resembles a square-size calculation. The degree sum depends on edges, not matrix cells."
        },
        {
          "key": "3",
          "text": "3",
          "feedback": "This divides the edge count by two. Each edge contributes two endpoints, so multiply by two."
        }
      ],
      "correct": "1",
      "explanation": "Count endpoints of edges: \\(2 \\times 6 = 12\\).",
      "sources": [
        "graphs"
      ],
      "blocks": [
        {
          "title": "Count each edge twice",
          "sources": [
            "graphs"
          ],
          "kind": "formula",
          "mathml": null,
          "latex": "\\sum_{v\\in V}\\deg(v)=2|E|",
          "plain": "The sum of all vertex degrees equals twice the number of edges.",
          "symbols": [
            {
              "symbol": "\\(V\\)",
              "meaning": "The set of vertices."
            },
            {
              "symbol": "\\(E\\)",
              "meaning": "The set of edges."
            },
            {
              "symbol": "\\(\\deg(v)\\)",
              "meaning": "The number of edges incident to vertex \\(v\\)."
            }
          ],
          "conditions": "For a simple undirected graph. Six edges contribute twelve to the total degree."
        }
      ]
    },
    {
      "key": "sparse-choice",
      "objective": "storage",
      "prompt": "A network has many vertices and few edges. You mainly traverse neighbors. Which representation fits this task?",
      "level": "reason",
      "options": [
        {
          "key": "0",
          "text": "An adjacency list",
          "feedback": "It stores existing connections and gives direct access to each neighbor list."
        },
        {
          "key": "1",
          "text": "An adjacency matrix for its smaller memory use",
          "feedback": "A matrix uses \\(O(|V|^2)\\) memory, including absent edges."
        },
        {
          "key": "2",
          "text": "A matrix because every graph is dense",
          "feedback": "The prompt describes a sparse graph. Density is a property of this graph, not all graphs."
        },
        {
          "key": "3",
          "text": "An edge list because it finds every vertex’s neighbors without scanning",
          "feedback": "An ordinary edge list may require scanning all edges to find one vertex’s neighbors. An adjacency list stores those neighbors together."
        }
      ],
      "correct": "0",
      "explanation": "The task favors neighbor traversal and compact storage of existing edges.",
